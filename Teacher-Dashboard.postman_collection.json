    {
      "name": "Schedules (teacher only)",
      "description": "Weekly recurring class sessions. Server warns on time overlaps but still saves.",
      "item": [
        {
          "name": "List Schedules",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/schedules",
              "host": ["{{baseUrl}}"],
              "path": ["schedules"],
              "query": [
                { "key": "dayOfWeek", "value": "0", "disabled": true, "description": "Optional: 0 (Sunday) to 6 (Saturday)" }
              ]
            },
            "description": "Returns all of the authenticated teacher's schedule entries, sorted by day then start time. No pagination."
          },
          "response": []
        },
        {
          "name": "Create Schedule",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data._id) {",
                  "    pm.collectionVariables.set('scheduleId', res.data._id);",
                  "    console.log('Saved scheduleId = ' + res.data._id);",
                  "}",
                  "if (res && res.warnings && res.warnings.length) {",
                  "    console.warn('Schedule overlap warnings:', res.warnings);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"subject\": \"{{subjectId}}\",\n    \"dayOfWeek\": 0,\n    \"startTime\": \"08:00\",\n    \"endTime\": \"09:30\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/schedules",
              "host": ["{{baseUrl}}"],
              "path": ["schedules"]
            },
            "description": "Required: subject (must belong to this teacher), dayOfWeek (0-6, 0=Sunday), startTime (HH:mm), endTime (HH:mm, after start). If overlapping with another active schedule, the response includes `warnings` but the entry is still saved."
          },
          "response": []
        },
        {
          "name": "Get Schedule by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/schedules/{{scheduleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["schedules", "{{scheduleId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Update Schedule",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"startTime\": \"09:00\",\n    \"endTime\": \"10:30\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/schedules/{{scheduleId}}",
