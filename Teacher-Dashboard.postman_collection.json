    {
      "name": "Attendance (teacher only)",
      "description": "One attendance record per (subject, date). Submit performs an upsert — re-submitting for the same subject + date updates the existing record.",
      "item": [
        {
          "name": "Submit Attendance (upsert)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data._id) {",
                  "    pm.collectionVariables.set('attendanceId', res.data._id);",
                  "    console.log('Saved attendanceId = ' + res.data._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"subject\": \"{{subjectId}}\",\n    \"date\": \"2026-04-30\",\n    \"records\": [\n        { \"student\": \"{{studentId}}\", \"status\": \"present\" }\n    ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/attendance",
              "host": ["{{baseUrl}}"],
              "path": ["attendance"]
            },
            "description": "201 on first save, 200 on update. status must be one of: present, absent, late."
          },
          "response": []
        },
        {
          "name": "List Attendance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/attendance?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["attendance"],
              "query": [
                { "key": "page",    "value": "1" },
                { "key": "limit",   "value": "10" },
                { "key": "subject", "value": "{{subjectId}}", "disabled": true },
                { "key": "from",    "value": "2026-04-01",     "disabled": true },
                { "key": "to",      "value": "2026-04-30",     "disabled": true }
              ]
            },
            "description": "Returns attendance sessions sorted by date desc with a per-session summary (`{ total, present, absent, late }`)."
